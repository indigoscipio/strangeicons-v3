---
---

<main class="main-content">
  <div class="grid-wrap" id="grid-wrap">
    <div class="icon-grid" id="icon-grid">
      <!-- Populated by app.js virtual scroller -->
    </div>
    <div class="empty-state" id="empty-state" style="display:none;">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 3H19V21H9C6.79086 21 5 19.2091 5 17V3Z" stroke="black" stroke-width="2"/>
        <path d="M16 16.0718C14.7838 15.3696 13.4043 15 12 15C10.5957 15 9.21615 15.3696 8 16.0718" stroke="black" stroke-width="2"/>
        <path d="M8 8H11V11H9C8.44772 11 8 10.5523 8 10V8Z" fill="black"/>
        <path d="M13 8H16V11H14C13.4477 11 13 10.5523 13 10V8Z" fill="black"/>
      </svg>
      <h2 class="empty-heading">Woops! No icons found.</h2>
      <p class="empty-sub">Please try a different search or style. 🔍</p>
    </div>
  </div>
</main>

<!-- Icon detail panel (bottom bar) -->
<div class="detail-panel" id="detail-panel" style="display:none;">
  <div class="panel-bar">
    <div class="panel-left">
      <div class="panel-preview" id="panel-preview"></div>
      <div class="panel-info">
        <p class="panel-name" id="panel-name"></p>
        <p class="panel-meta" id="panel-meta"></p>
        <div class="panel-styles" id="panel-styles"></div>
      </div>
    </div>
    <div class="panel-actions">
      <button class="panel-btn primary" id="btn-copy-svg">Copy SVG</button>
      <button class="panel-btn" id="btn-download">Download</button>
    </div>
    <button class="panel-close" id="panel-close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .main-content {
    margin-left: var(--sidebar-w);
    padding-top: var(--topbar-h);
    min-height: 100vh;
    transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grid-wrap {
    padding: 1.75rem 1.5rem;
  }

  /* Grid uses absolute positioning for virtual scroll children */
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 0.375rem;
    position: relative; /* children use absolute positioning */
  }

  /* Icon cards — rendered by JS */
  :global(.icon-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0 0 var(--radius-lg) 0;
    cursor: pointer;
    transition: border-color 0.12s, box-shadow 0.12s, transform 0.1s, background 0.12s;
    min-height: 5.5rem;
    height: 5.875rem; /* fixed height for virtual scroll accuracy */
    content-visibility: auto;
    contain-intrinsic-size: 5.875rem;
  }

  :global(.icon-card:hover) {
    background: var(--surface);
    border-color: var(--border);
    box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  :global(.icon-card.selected) {
    background: var(--surface);
    border-color: var(--accent);
  }

  :global(.icon-card.flash) {
    background: var(--copy-flash);
    border-color: #86efac;
  }

  :global(.icon-card svg),
  :global(.icon-card img) {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  :global(.icon-card-name) {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.3;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 5rem 0;
    color: var(--text-subtle);
  }

  .empty-icon {
    font-size: 1.75rem;
    margin-bottom: 4px;
  }

  .empty-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .empty-sub {
    color: var(--text-muted);
  }

  /* ── Detail panel (bottom bar) ──────────────────────────────────────── */
  .detail-panel {
    position: fixed;
    bottom: 0;
    left: var(--sidebar-w);
    right: 0;
    z-index: 50;
    display: flex;
  }

  .panel-bar {
    display: flex;
    align-items: center;
    border-top-right-radius: var(--radius-lg);
    gap: 1rem;
    margin: 1.5rem 2rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid black;
    box-shadow: 0 -0.25rem 1.5rem rgba(0, 0, 0, 0.06);
    width: 100%;
  }

  .panel-close {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    flex-shrink: 0;
    transition: background 0.12s;
  }

  .panel-close:hover {
    background: var(--bg);
    color: var(--text-primary);
  }

  .panel-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .panel-preview {
    width: 6rem;
    height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .panel-preview svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .panel-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-name {
    font-weight: 600;
    color: var(--text-primary);
    text-transform: capitalize;
  }

  .panel-meta {
    font-size: 0.825rem;
    color: var(--text-subtle);
    text-transform: capitalize;
  }

  .panel-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .panel-actions {
    justify-content: flex-end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-left: auto;
  }

  .panel-btn {
    padding: 0.75rem 1rem;
    border-top-left-radius: var(--radius-md);
    font-weight: 500;
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
    transition: background 0.12s, border-color 0.12s;
    white-space: nowrap;
  }

  .panel-btn:hover {
    background: var(--border);
  }

  .panel-btn.primary {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .panel-btn.primary:hover {
    background: var(--accent-hover);
  }

  :global(.style-chip) {
    font-size: 0.825rem;
    padding: 0.25rem 0.5rem;
    border-bottom-right-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    text-transform: capitalize;
    transition: background 0.1s, border-color 0.1s;
    white-space: nowrap;
  }

  :global(.style-chip.active) {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  :global(.style-chip:hover:not(.active)) {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  /* ── Mobile ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .main-content {
      margin-left: 0;
    }

    .grid-wrap {
      padding: 1rem 0.75rem;
    }

    .icon-grid {
      grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
      gap: 4px;
      position: relative;
      display: block;
    }

    :global(.icon-card) {
      padding: 0.75rem 4px 0.625rem;
      min-height: 4.75rem;
      height: 5rem;
    }

    .detail-panel {
      left: 0;
      z-index: 5;
    }

    .panel-bar {
      flex-direction: column;
      align-items: stretch;
      margin: 1rem;
      gap: 0.625rem;
      padding: 2.5rem 0.75rem 0.75rem;
      position: relative;
    }

    .panel-left {
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }

    .panel-info {
      align-items: center;
      text-align: center;
    }

    .panel-styles {
      justify-content: center;
    }

    .panel-actions {
      justify-content: center;
      margin-left: 0;
    }

    .panel-close {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
    }

    .panel-preview{
      width: 4rem;
      height: 4rem;
    }

  }

  /* ── Tablet ──────────────────────────────────────────────────────────── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .grid-wrap {
      padding: 1.25rem 1rem;
    }
  }
</style>
