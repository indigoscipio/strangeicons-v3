---
---

<main class="main-content">
  <div class="grid-wrap" id="grid-wrap">
    <div class="icon-grid" id="icon-grid">
      <!-- Populated by app.js virtual scroller -->
    </div>
    <div class="empty-state" id="empty-state" style="display:none;">
      <span class="empty-icon">⊘</span>
      <p>No icons found</p>
      <span>Try a different search or style</span>
    </div>
  </div>
</main>

<!-- Icon detail panel -->
<div class="detail-panel" id="detail-panel" style="display:none;">
  <div class="panel-backdrop" id="panel-backdrop"></div>
  <div class="panel-card">
    <button class="panel-close" id="panel-close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="panel-preview" id="panel-preview"></div>
    <div class="panel-info">
      <p class="panel-name" id="panel-name"></p>
      <p class="panel-meta" id="panel-meta"></p>
    </div>
    <div class="panel-actions">
      <button class="panel-btn primary" id="btn-copy-svg">Copy SVG</button>
      <button class="panel-btn" id="btn-copy-name">Copy name</button>
      <button class="panel-btn" id="btn-download">Download</button>
    </div>
    <div class="panel-styles" id="panel-styles"></div>
  </div>
</div>

<style>
  .main-content {
    margin-left: var(--sidebar-w);
    padding-top: var(--topbar-h);
    min-height: 100vh;
    transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grid-wrap {
    padding: 28px 24px;
  }

  /* Grid uses absolute positioning for virtual scroll children */
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 6px;
    position: relative; /* children use absolute positioning */
  }

  /* Icon cards — rendered by JS */
  :global(.icon-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 8px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color 0.12s, box-shadow 0.12s, transform 0.1s;
    min-height: 88px;
    height: 94px; /* fixed height for virtual scroll accuracy */
    content-visibility: auto;
    contain-intrinsic-size: 94px;
  }

  :global(.icon-card:hover) {
    border-color: var(--border-hover);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  :global(.icon-card.flash) {
    background: var(--copy-flash);
    border-color: #86efac;
  }

  :global(.icon-card svg),
  :global(.icon-card img) {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  :global(.icon-card-name) {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.3;
    word-break: break-all;
    max-width: 100%;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 80px 0;
    color: var(--text-subtle);
  }

  .empty-icon {
    font-size: 28px;
    margin-bottom: 4px;
  }

  .empty-state p {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .empty-state span {
    font-size: 13px;
  }

  /* Detail panel */
  .detail-panel {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .panel-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(2px);
  }

  .panel-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    z-index: 1;
  }

  .panel-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: background 0.12s;
  }

  .panel-close:hover {
    background: var(--bg);
    color: var(--text-primary);
  }

  .panel-preview {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .panel-preview svg,
  .panel-preview img {
    width: 44px;
    height: 44px;
  }

  .panel-info {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .panel-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: capitalize;
  }

  .panel-meta {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    text-transform: capitalize;
  }

  .panel-actions {
    display: flex;
    gap: 6px;
    width: 100%;
  }

  .panel-btn {
    flex: 1;
    padding: 8px 0;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
    transition: background 0.12s, border-color 0.12s;
  }

  .panel-btn:hover {
    background: var(--border);
  }

  .panel-btn.primary {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .panel-btn.primary:hover {
    background: var(--accent-hover);
  }

  .panel-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: center;
    width: 100%;
  }

  :global(.style-chip) {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 3px 8px;
    border-radius: 20px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    text-transform: capitalize;
    transition: background 0.1s, border-color 0.1s;
  }

  :global(.style-chip.active) {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  :global(.style-chip:hover:not(.active)) {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  /* ── Mobile ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .main-content {
      margin-left: 0;
    }

    .grid-wrap {
      padding: 16px 12px;
    }

    .icon-grid {
      grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
      gap: 4px;
      position: relative;
      display: block;
    }

    :global(.icon-card) {
      padding: 12px 4px 10px;
      min-height: 76px;
      height: 80px;
    }

    .panel-card {
      width: calc(100vw - 32px);
      max-width: 340px;
    }
  }

  /* ── Tablet ──────────────────────────────────────────────────────────── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .grid-wrap {
      padding: 20px 16px;
    }
  }
</style>