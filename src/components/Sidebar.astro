---
import library from '../data/library.json';

interface Props {
  families: string[];
  styles:   string[];
}
const { families, styles } = Astro.props;
const defaultFamily = families.includes(library.defaultFamily)
  ? library.defaultFamily
  : families[0];
const conceptCount = library.iconConceptCount.toLocaleString('en-US');
const variantCount = library.iconVariantCount.toLocaleString('en-US');
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <img src="/logo.svg" alt="strangeicons" class="brand-logo" />
    <span class="version-badge">v{library.siteVersion}</span>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-label">Family</span>
      <ul class="nav-list" id="family-list">
        {families.map((family) => (
          <li>
            <button
              class={`nav-item${family === defaultFamily ? ' active' : ''}`}
              data-filter="family"
              data-value={family}
            >
              <span class="nav-item-dot"></span>
              {family}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-section">
      <span class="nav-label">Style</span>
      <ul class="nav-list" id="style-list">
        {styles.map((style) => (
          <li>
            <button
              class={`nav-item${style === library.defaultStyle ? ' active' : ''}`}
              data-filter="style"
              data-value={style}
            >
              <span class="nav-item-dot"></span>
              {style}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-ctas">
      <a href="https://www.figma.com/community/plugin/1444854975916128113/strangeicons-healthcare-biotech-ui-icons" target="_blank" rel="noopener" class="cta-btn primary">Figma Plugin 🤖</a>
      <a href={library.downloadUrl} target="_blank" rel="noopener" class="cta-btn secondary">Download All 📦</a>
    </div>
    <span class="count-badge">{conceptCount} icons · {variantCount} variants</span>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-w);
    height: 100vh;
    background: var(--surface);
    border-right: 1px solid var(--border);
    border-bottom-right-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    z-index: 10;
    overflow-y: auto;
    transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Mobile: hide off-screen, slide in when .open */
  @media (max-width: 767px) {
    .sidebar {
      width: 15rem;
      transform: translateX(-100%);
      box-shadow: 4px 0 1.5rem rgba(0, 0, 0, 0.08);
    }
    .sidebar.open {
      transform: translateX(0);
    }
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  
  .brand-logo {
    height: 1.25rem;
    width: auto;
    flex-shrink: 0;
  }

  .version-badge {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
    border: 1px solid var(--accent);
    border-top-left-radius: var(--radius-sm);
    padding: 1px 4px;
    line-height: 1.3;
    margin-left: auto;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    padding: 0 0.5rem;
    margin-bottom: 4px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-top-right-radius: var(--radius-md);
    font-weight: 400;
    color: var(--text-muted);
    text-align: left;
    transition: background 0.12s, color 0.12s;
    text-transform: capitalize;
  }

  .nav-item:hover {
    background: var(--bg);
    color: var(--text-primary);
  }

  .nav-item.active {
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
    font-weight: 500;
  }

  .nav-item-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-bottom-right-radius: 4px;
    background: var(--border);
    flex-shrink: 0;
    transition: background 0.12s;
  }

  .nav-item.active .nav-item-dot,
  .nav-item:hover .nav-item-dot {
    background: var(--text-primary);
  }

  .sidebar-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sidebar-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .cta-btn {
    padding: .75rem 1rem;
    border-top-left-radius: var(--radius-lg);
    font-size: 0.825rem;
    font-weight: 500;
    text-align: center;
    transition: background 0.12s;
  }

  .cta-btn.primary {
    background: var(--accent);
    color: white;
    border: 1px solid var(--accent);
  }

  .cta-btn.primary:hover {
    background: var(--accent-hover);
  }

  .cta-btn.secondary {
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .cta-btn.secondary:hover {
    border-color: var(--border-hover);
  }

  .count-badge {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
</style>
