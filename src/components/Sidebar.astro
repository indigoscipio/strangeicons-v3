---
interface Props {
  families: string[];
  styles:   string[];
}
const { families, styles } = Astro.props;
const DEFAULT_STYLE = 'regular';
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <span class="brand-mark">✦</span>
    <span class="brand-name">strangeicons</span>
    <span class="version-badge">v3.1</span>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-label">Library</span>
      <ul class="nav-list" id="family-list">
        {families.map((family, i) => (
          <li>
            <button
              class={`nav-item${i === 0 ? ' active' : ''}`}
              data-filter="family"
              data-value={family}
            >
              <span class="nav-item-dot"></span>
              {family}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-section">
      <span class="nav-label">Style</span>
      <ul class="nav-list" id="style-list">
        {styles.map((style) => (
          <li>
            <button
              class={`nav-item${style === DEFAULT_STYLE ? ' active' : ''}`}
              data-filter="style"
              data-value={style}
            >
              <span class="nav-item-dot"></span>
              {style}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-ctas">
      <button class="cta-btn primary">Figma plugin</button>
      <button class="cta-btn secondary">Download all</button>
    </div>
    <span class="count-badge">39,000+ icons · 6 families</span>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-w);
    height: 100vh;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 10;
    overflow-y: auto;
    transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Mobile: hide off-screen, slide in when .open */
  @media (max-width: 767px) {
    .sidebar {
      width: 15rem;
      transform: translateX(-100%);
      box-shadow: 4px 0 1.5rem rgba(0, 0, 0, 0.08);
    }
    .sidebar.open {
      transform: translateX(0);
    }
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .brand-mark {
    font-size: 0.875rem;
    color: var(--text-primary);
    line-height: 1;
  }

  .brand-name {
    font-size: 0.813rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .version-badge {
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--text-subtle);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 1px 4px;
    line-height: 1.3;
    margin-left: auto;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    padding: 0 0.5rem;
    margin-bottom: 4px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.813rem;
    font-weight: 400;
    color: var(--text-muted);
    text-align: left;
    transition: background 0.12s, color 0.12s;
    text-transform: capitalize;
  }

  .nav-item:hover {
    background: var(--bg);
    color: var(--text-primary);
  }

  .nav-item.active {
    background: var(--bg);
    color: var(--text-primary);
    font-weight: 500;
  }

  .nav-item-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
    transition: background 0.12s;
  }

  .nav-item.active .nav-item-dot,
  .nav-item:hover .nav-item-dot {
    background: var(--text-primary);
  }

  .sidebar-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sidebar-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .cta-btn {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
    text-align: center;
    transition: background 0.12s;
  }

  .cta-btn.primary {
    background: var(--accent);
    color: white;
    border: 1px solid var(--accent);
  }

  .cta-btn.primary:hover {
    background: var(--accent-hover);
  }

  .cta-btn.secondary {
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .cta-btn.secondary:hover {
    border-color: var(--border-hover);
  }

  .count-badge {
    font-size: 0.688rem;
    color: var(--text-subtle);
  }
</style>
