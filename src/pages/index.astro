---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import IconGrid from '../components/IconGrid.astro';
import library from '../data/library.json';
import { existsSync, readdirSync, readFileSync } from 'fs';

let families = [];
let styles   = [];

if (existsSync('./public/icons')) {
  families = readdirSync('./public/icons').sort();
  const styleFamily = families.includes(library.defaultFamily)
    ? library.defaultFamily
    : families[0];
  styles = styleFamily
    ? readdirSync(`./public/icons/${styleFamily}`).sort()
    : [];
} else if (existsSync('./src/icons.json')) {
  const index = JSON.parse(readFileSync('./src/icons.json', 'utf-8'));
  const familySet = new Set();
  const styleSet  = new Set();
  for (const icon of index) {
    familySet.add(icon.family);
    icon.styles.forEach(s => styleSet.add(s));
  }
  families = [...familySet].sort();
  styles   = [...styleSet].sort();
}

const defaultFamily = families.includes(library.defaultFamily)
  ? library.defaultFamily
  : families[0] || library.defaultFamily;
const defaultStyle = library.defaultStyle;
let defaultSprite   = '';
try {
  defaultSprite = readFileSync(
    `./public/sprites/${defaultFamily}-${defaultStyle}.svg`, 'utf-8'
  );
} catch {}
---

<Layout>
  <!-- Hidden SVG sprite sheet (inlined at build time) -->
  <div id="sprite-sheet" style="display:none" set:html={defaultSprite} />

  <!-- Mobile sidebar overlay -->
  <div id="sidebar-overlay"></div>

  <Sidebar families={families} styles={styles} />
  <TopBar />
  <IconGrid />

  <!-- Footer -->
  <footer class="site-footer">
    <span class="footer-copy">© {new Date().getFullYear()} strangeicons</span>
    <nav class="footer-links">
      <a href={library.repositoryUrl} target="_blank" rel="noopener">GitHub</a>
      <a href="https://opensource.org/license/mit" target="_blank" rel="noopener">License</a>
      <a href="mailto:hello@strangeicons.com">Contact</a>
    </nav>
  </footer>
</Layout>

<script>
  import '../scripts/app.js';
</script>
