{
  "name": "proper-pulsar",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:index": "node src/scripts/build-index.js",
    "build:index:release": "node src/scripts/build-index.js --require-icons",
    "audit:icons": "node src/scripts/audit-icons.js",
    "audit:icons:release": "node src/scripts/audit-icons.js --require-icons",
    "icons:rename": "node src/scripts/apply-icon-renames.js",
    "icons:rename:apply": "node src/scripts/apply-icon-renames.js --apply",
    "dev": "npm run build:index && astro dev",
    "build": "npm run build:index && astro build",
    "build:release": "npm run build:index:release && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2"
  }
}
